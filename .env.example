# Copy this file to `.env`. Never commit the populated file.

PYDEBUGGER_AI_PROVIDER="gemini"
GOOGLE_API_KEY="<your-google-ai-studio-key>"
GOOGLE_CHAT_MODEL="gemini-3.5-flash-lite"
GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"

# Required only when PYDEBUGGER_AI_PROVIDER="azure_openai".
AZURE_OPENAI_ENDPOINT="https://<resource-name>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-api-key>"
AZURE_CHAT_DEPLOYMENT="<chat-deployment-name>"
AZURE_EMBEDDING_DEPLOYMENT="<embedding-deployment-name>"
AZURE_OPENAI_API_VERSION="2024-10-21"

# Consolidated backend settings
PYDEBUGGER_DATA_DIR=".pydebugger-data"
PYDEBUGGER_VECTOR_DIR=".pydebugger-data/chroma"
PYDEBUGGER_VECTOR_COLLECTION="pydebugger-gemini-content"
PYDEBUGGER_MONITORING_DB=".pydebugger-data/monitoring.sqlite3"
# Set these to the rates for the configured Gemini or Azure models.
PYDEBUGGER_CHAT_INPUT_COST_PER_MILLION="0"
PYDEBUGGER_CHAT_OUTPUT_COST_PER_MILLION="0"
PYDEBUGGER_EMBEDDING_COST_PER_MILLION="0"
PYDEBUGGER_UPLOAD_LIMIT_BYTES="10485760"
PYDEBUGGER_BACKGROUND_WORKERS="2"
PYDEBUGGER_BACKGROUND_QUEUE_SIZE="8"
PYDEBUGGER_INGESTION_TIMEOUT_SECONDS="120"
PYDEBUGGER_INGESTION_MAX_ATTEMPTS="3"
PYDEBUGGER_RETRIEVAL_LIMIT="5"
PYDEBUGGER_RETRIEVAL_MIN_SCORE="0.25"
PYDEBUGGER_EXECUTION_BACKEND="disabled"
PYDEBUGGER_EXECUTION_TIMEOUT_SECONDS="5"
PYDEBUGGER_EXECUTION_MAX_ATTEMPTS="2"
PYDEBUGGER_EXECUTION_OUTPUT_LIMIT="20000"
PYDEBUGGER_EXECUTION_SOURCE_LIMIT="100000"
PYDEBUGGER_EXECUTION_MEMORY_MB="128"
PYDEBUGGER_EXECUTION_CPUS="0.5"
PYDEBUGGER_EXECUTION_PIDS_LIMIT="32"
PYDEBUGGER_EXECUTION_TMPFS_MB="16"

# Required only when PYDEBUGGER_EXECUTION_BACKEND="docker".
# Keep the image pinned to an immutable digest.
PYDEBUGGER_DOCKER_BINARY="docker"
PYDEBUGGER_DOCKER_IMAGE="python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72"
# Optional hardened runtime, for example "runsc" when gVisor is installed.
# PYDEBUGGER_DOCKER_RUNTIME="runsc"
